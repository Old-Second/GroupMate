{
  "name": "groupmate",
  "version": "0.1.0",
  "description": "A group-native conversational participant and task runtime for Yunzai",
  "type": "module",
  "author": "Old-Second",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Old-Second/GroupMate.git"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm run build && node --test --test-concurrency=1 test/unit/*.test.js test/characterization/*.test.js && pnpm run test:ts",
    "test:unit": "pnpm run build && node --test --test-concurrency=1 test/unit/*.test.js && pnpm run test:ts",
    "test:ts": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 .test-dist/test/unit/*.test.js",
    "test:characterization": "node --test --test-concurrency=1 test/characterization/*.test.js",
    "test:online:openai": "node scripts/smoke-openai-compatible.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^8.3.0",
    "@fastify/cors": "^8.2.0",
    "@fastify/static": "^6.9.0",
    "@fastify/websocket": "^8.2.0",
    "diff": "^5.1.0",
    "emoji-strip": "^1.0.1",
    "eventsource-parser": "^1.0.0",
    "fastify": "^4.18.0",
    "form-data": "^4.0.0",
    "https-proxy-agent": "7.0.1",
    "keyv-file": "^0.2.0",
    "lodash": "^4.17.21",
    "microsoft-cognitiveservices-speech-sdk": "1.32.0",
    "node-fetch": "^3.3.1",
    "random": "^4.1.0",
    "undici": "^5.21.0",
    "ws": "^8.13.0"
  },
  "optionalDependencies": {
    "@node-rs/jieba": "^1.6.2",
    "jimp": "^0.22.7",
    "mammoth": "^1.6.0",
    "node-silk": "^0.1.0",
    "nodejs-pptx": "^1.2.4",
    "pdfjs-dist": "^3.11.174",
    "sharp": "^0.32.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "ts-node": "^10.9.1",
    "ts-node-register": "^1.0.0",
    "typescript": "^5.9.3"
  }
}
